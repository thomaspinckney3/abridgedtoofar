          "source_chapter": 3,
          "source_frame_number": 2,
          "texts": [
            {
              "kind": "caption",
              "text": "The house was full; I asked for a room and agreed to share. I never liked to sleep two in a bed.",
              "caption_zone": "top_center",
              "lettering_notes": "demoted from speech: indirect or internal narration"
            },
            {
              "kind": "speech",
              "text": "Hain’t no objections to sharing a harpooneer’s blanket?",
              "speaker": "Peter Coffin",
              "balloon_zone": "bottom_right",
              "speaker_region": "right",
              "source_evidence": "\"you haint no objections to sharing a harpooneer’s blanket, have ye?\""
            }
          ]
        }
      ]
    },
