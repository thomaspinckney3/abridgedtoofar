          "texts": [
            {
              "kind": "caption",
              "text": "He sprang into bed with the tomahawk-pipe. Peter Coffin said, \"Don’t be afraid; Queequeg won’t harm a hair of your head.\"",
              "caption_zone": "top_center",
              "lettering_notes": "demoted from speech: panel exceeded 2 balloons"
            },
            {
              "kind": "speech",
              "text": "Who-e debel you? You no speak-e—dam-me, I kill-e!",
              "speaker": "Queequeg",
              "balloon_zone": "bottom_left",
              "speaker_region": "center",
              "source_evidence": "\"Who-e debel you?—you no speak-e, dam-me, I kill-e.\""
            },
            {
              "kind": "speech",
              "text": "Landlord! For God’s sake—Peter Coffin! Watch! Angels! save me!",
              "speaker": "Ishmael",
              "balloon_zone": "bottom_right",
              "speaker_region": "left",
              "source_evidence": "\"Landlord, for God’s sake, Peter Coffin! ... Watch! ... Angels! save me!\""
            }
          ]
        },
        {
          "panel_number": 8,
          "image": "ch003_frame_008.png",
          "box": {
            "x": 0.015625,
            "y": 0.50439453125,
            "w": 0.96875,
            "h": 0.48388671875
          },
          "source_chapter": 3,
          "source_frame_number": 8,
          "texts": [
            {
              "kind": "caption",
              "text": "He stashed the tomahawk-pipe; I turned in again and slept soundly.",
              "caption_zone": "top_center"
            },
            {
              "kind": "thought",
              "text": "Better sleep with a sober cannibal than a drunken Christian.",
              "speaker": "Ishmael",
              "balloon_zone": "bottom_left",
              "speaker_region": "left",
              "source_evidence": "\"Better sleep with a sober cannibal than a drunken Christian.\""
            },
            {
              "kind": "speech",
              "text": "Tell him to stash that tomahawk-pipe. No smoking—I ain’t insured.",
              "speaker": "Ishmael",
              "balloon_zone": "bottom_right",
              "speaker_region": "left",
              "source_evidence": "\"tell him to stash his tomahawk there, or pipe... tell him to stop smoking... Besides, I ain’t insured.\""
            }
          ]
        }
