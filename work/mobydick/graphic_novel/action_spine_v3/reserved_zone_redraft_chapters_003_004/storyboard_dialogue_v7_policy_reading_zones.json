          "texts": [
            {
              "kind": "caption",
              "text": "I entered the Spouter-Inn and, after much pondering and throwing open the little window, I made out the smoke-dark painting: a half-foundered ship and an exasperated whale springing upon her three masts.",
              "caption_zone": "top_left"
            }
