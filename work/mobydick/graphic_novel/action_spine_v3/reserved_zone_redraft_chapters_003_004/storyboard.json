          },
          "source_chapter": 4,
          "source_frame_number": 7,
          "texts": [
            {
              "kind": "caption",
              "text": "Then I saw him coolly shave with the head of his harpoon, and, his toilet complete, he marched out in his pilot monkey jacket, sporting the harpoon like a marshal’s baton.",
              "caption_zone": "top_left"
            }
          ]
        }
      ]
    }
