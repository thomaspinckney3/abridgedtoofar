        "x2": 1536,
        "y2": 1024
      }
    },
    {
      "frame_number": 3,
      "caption": "I do not go as a passenger, nor as an officer, but before the mast, where I may be ordered about, paid for my pains, and knocked into right temper.",
      "caption_zone": "bottom_right",
      "source_image": "work/mobydick/graphic_novel/chapter1_four_frame_spine/generated_frames/frame_003.png",
