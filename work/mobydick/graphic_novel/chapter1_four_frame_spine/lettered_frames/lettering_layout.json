      "frame_number": 2,
      "caption": "Whenever I feel that damp, drizzly November in my soul, I know it is high time to get to sea.",
      "caption_zone": "top_center",
      "source_image": "work/mobydick/graphic_novel/chapter1_four_frame_spine/generated_frames/frame_002.png",
      "lettered_image": "work/mobydick/graphic_novel/chapter1_four_frame_spine/lettered_frames/frame_002.png",
