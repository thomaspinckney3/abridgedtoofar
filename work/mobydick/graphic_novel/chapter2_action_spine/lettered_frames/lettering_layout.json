        "y1": 0,
        "x2": 1536,
        "y2": 1024
      }
    },
    {
      "frame_number": 5,
      "caption": "At last I found the creaking Spouter-Inn, with Peter Coffin's name beneath the sign, and took it for the cheap spot I needed.",
      "caption_zone": "top_right",
      "source_image": "work/mobydick/graphic_novel/chapter2_action_spine/generated_frames/frame_005.png",
      "lettered_image": "work/mobydick/graphic_novel/chapter2_action_spine/lettered_frames/frame_005.png",
