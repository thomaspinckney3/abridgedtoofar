        "y1": 0,
        "x2": 1536,
        "y2": 1024
      }
    },
    {
      "frame_number": 4,
      "caption": "In the dark streets I stumbled into a smoky church, found no bed there, and backed out again.",
      "caption_zone": "top_left",
      "source_image": "work/mobydick/graphic_novel/chapter2_action_spine/generated_frames/frame_004.png",
      "lettered_image": "work/mobydick/graphic_novel/chapter2_action_spine/lettered_frames/frame_004.png",
