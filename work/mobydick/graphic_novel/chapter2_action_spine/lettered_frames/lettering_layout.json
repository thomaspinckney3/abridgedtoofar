        "x2": 1536,
        "y2": 1024
      }
    },
    {
      "frame_number": 2,
      "caption": "My mind was made up for a Nantucket craft, so I had a night, a day, and another night to eat and sleep as cheaply as I could.",
      "caption_zone": "top_center",
      "source_image": "work/mobydick/graphic_novel/chapter2_action_spine/generated_frames/frame_002.png",
      "lettered_image": "work/mobydick/graphic_novel/chapter2_action_spine/lettered_frames/frame_002.png",
      "frame_box": {
        "x1": 0,
        "y1": 0,
        "x2": 1536,
        "y2": 1024
      }
    },
    {
      "frame_number": 3,
      "caption": "With only a few pieces of silver in my pocket, I passed the bright, jolly inns and kept waterward.",
      "caption_zone": "bottom_right",
      "source_image": "work/mobydick/graphic_novel/chapter2_action_spine/generated_frames/frame_003.png",
