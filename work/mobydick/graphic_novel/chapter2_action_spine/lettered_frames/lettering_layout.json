    {
      "frame_number": 1,
      "caption": "With my old carpet-bag under my arm, I came to New Bedford on a black December Saturday, too late for the Nantucket packet.",
      "caption_zone": "top_left",
      "source_image": "work/mobydick/graphic_novel/chapter2_action_spine/generated_frames/frame_001.png",
