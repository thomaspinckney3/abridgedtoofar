    {
      "frame_number": 1,
      "caption": "Upon waking about daylight, I found Queequeg\u2019s tattooed arm thrown over me, blending with the patchwork counterpane until its weight told me I was hugged.",
      "caption_zone": "bottom_right",
      "source_image": "work/mobydick/graphic_novel/action_spine_auto/chapter_004/generated_frames/frame_001.png",
      "lettered_image": "work/mobydick/graphic_novel/action_spine_auto/chapter_004/lettered_frames/frame_001.png",
      "frame_box": {
