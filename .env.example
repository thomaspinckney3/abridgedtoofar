# Provider API keys
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Lean pipeline model routing (recommended defaults).
# Per-stage env vars beat FORAGE_MODEL and beat whatever the caller passes
# into forage.llm.complete().
FORAGE_DRAFT_MODEL=openai:gpt-5
FORAGE_REGEN_MODEL=openai:gpt-5
FORAGE_CRITIC_MODEL=anthropic:claude-sonnet-4-6

# Optional: override the drafter's auto-fallback model for OpenAI
# content_filter retries. Default is anthropic:claude-sonnet-4-6.
# FORAGE_DRAFT_FALLBACK_MODEL=anthropic:claude-opus-4-7

# Optional: memoize every LLM response to work/.replay_cache/<hash>.json so
# reruns with identical prompts serve from cache. Useful while iterating on
# pipeline logic without repaying.
FORAGE_REPLAY=1

# Optional global fallback if no per-stage override is set.
# FORAGE_MODEL=anthropic:claude-sonnet-4-6
