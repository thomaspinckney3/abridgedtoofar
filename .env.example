# Provider API keys
# Multi-workspace Anthropic keys also require ANTHROPIC_WORKSPACE_ID.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Lean pipeline model routing (recommended defaults).
# Per-stage env vars beat FORAGE_MODEL and beat whatever the caller passes
# into forage.llm.complete().
FORAGE_DRAFT_MODEL=anthropic:claude-opus-5-5
FORAGE_REGEN_MODEL=anthropic:claude-opus-5-5
FORAGE_CRITIC_MODEL=anthropic:claude-sonnet-5-5
FORAGE_CLASSIFY_MODEL=anthropic:claude-sonnet-5-5
FORAGE_SUMMARIZE_MODEL=openai:gpt-6-astra
FORAGE_CUTS_MODEL=openai:gpt-6-astra
FORAGE_COHERENCE_MODEL=anthropic:claude-sonnet-5-5
FORAGE_COHERENCE_FIX_MODEL=anthropic:claude-sonnet-5-5
FORAGE_ALIGN_MODEL=anthropic:claude-sonnet-5-5
FORAGE_REVIEW_APPLY_MODEL=anthropic:claude-sonnet-5-5

# Optional: override the drafter's cross-provider fallback.
# Anthropic failures default to openai:gpt-6-astra; OpenAI failures or
# content_filter responses default to anthropic:claude-sonnet-5-5.
# FORAGE_DRAFT_FALLBACK_MODEL=openai:gpt-6-astra

# Optional: override coherence-fix fallback when Anthropic API calls fail.
# Default is openai:gpt-6-astra.
# FORAGE_COHERENCE_FIX_FALLBACK_MODEL=openai:gpt-6-astra

# Optional: memoize every LLM response to work/.replay_cache/<hash>.json so
# reruns with identical prompts serve from cache. Useful while iterating on
# pipeline logic without repaying. Model upgrades use different cache keys;
# misses still issue paid API calls.
FORAGE_REPLAY=1

# Optional global fallback if no per-stage override is set.
# FORAGE_MODEL=anthropic:claude-sonnet-5-5

# Optional audiobook generation defaults.
# ELEVENLABS_API_KEY=...
# FORAGE_AUDIOBOOK_MODEL=eleven_multilingual_v2
# FORAGE_AUDIOBOOK_OUTPUT_FORMAT=mp3_44100_128
# FORAGE_AUDIOBOOK_MAX_CHARS=9000

# Editorial review accounts: first startup only, then remove these variables.
# FORAGE_BOOTSTRAP_ADMIN_USERNAME=admin
# FORAGE_BOOTSTRAP_ADMIN_PASSWORD=<unique password, 15-128 characters>
# Pipeline publishing: use an account with the administrator role.
# FORAGE_REVIEW_URL=https://forage-review.fly.dev
# FORAGE_ADMIN_USERNAME=pipeline
# FORAGE_ADMIN_PASSWORD=<publishing account password>
