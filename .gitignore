# Secrets — NEVER commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
.python-version
dist/
build/

# Editors / OS
.DS_Store
.vscode/
.idea/
*.swp

# Claude Code runtime state (not repo-relevant)
.claude/

# Review app state: the comment queue is per-deployment, not repo content
work/_review/

# Advisory process locks are recreated by pipeline workers.
work/**/.production.lock
work/**/.ledger.lock

# Deploy payload — derived from work/ by scripts/package_review_artifacts.py
deploy/

# Large graphic-novel rendered outputs. Keep stage-level pipeline metadata,
# prompts, source excerpts, JSON reports/manifests, and replay caches trackable.
work/**/graphic_novel/**/*.png
work/**/graphic_novel/**/*.jpg
work/**/graphic_novel/**/*.jpeg
work/**/graphic_novel/**/*.webp
work/**/graphic_novel/**/*.gif
work/**/graphic_novel/**/*.tif
work/**/graphic_novel/**/*.tiff
work/**/graphic_novel/**/*.pdf
work/**/graphic_novel/**/lettered_pages*/layout.json
work/**/graphic_novel/**/lettered_pages*/lettering_layout.json
